# Security adversarial soak configuration.
#
# The historical filename follows the Phase 5 plan. The approved execution
# budget is 30 minutes, and this file is the sole soak configuration for the
# phase. Run it once only after implementation, validation, fixes, and the
# independent review audit are complete.
#
# Usage:
#   set -a
#   source tasks/security/adversarial_security_1h.env
#   set +a
#   cargo test --release --test adversarial_workload_tests \
#     overnight -- --ignored --nocapture

TEST_BACKEND=minio
ZEPPELIN_ADVERSARIAL_SECONDS=1800
ZEPPELIN_ADVERSARIAL_MODE=chaos
ZEPPELIN_ADVERSARIAL_PROFILE=security
ZEPPELIN_ADVERSARIAL_SEEDS=1
ZEPPELIN_ADVERSARIAL_PRESERVE=on-failure
ZEPPELIN_ADVERSARIAL_ARTIFACTS=target/adversarial/security-30m
