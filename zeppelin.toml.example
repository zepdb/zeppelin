# Zeppelin configuration
# Copy to zeppelin.toml and uncomment values to override defaults.
# Environment variables (shown in comments) take precedence over file values.
# Set ZEPPELIN_CONFIG to point to a custom config file path.

[server]
# host = "0.0.0.0"                   # ZEPPELIN_HOST
# port = 8080                        # ZEPPELIN_PORT; must be > 0
# request_timeout_secs = 30          # ZEPPELIN_REQUEST_TIMEOUT_SECS; must be > 0
# max_concurrent_queries = 64        # ZEPPELIN_MAX_CONCURRENT_QUERIES
# max_batch_size = 50000             # ZEPPELIN_MAX_BATCH_SIZE
# max_top_k = 10000                  # ZEPPELIN_MAX_TOP_K; must be > 0
# default_top_k = 10                 # ZEPPELIN_DEFAULT_TOP_K; must be in 1..=max_top_k
# shutdown_timeout_secs = 30         # ZEPPELIN_SHUTDOWN_TIMEOUT_SECS; must be > 0
# max_dimensions = 65536             # ZEPPELIN_MAX_DIMENSIONS
# max_vector_id_length = 1024        # ZEPPELIN_MAX_VECTOR_ID_LENGTH
# max_request_body_mb = 512          # ZEPPELIN_MAX_REQUEST_BODY_MB
# rate_limit_rps = 10                # ZEPPELIN_RATE_LIMIT_RPS
# rate_limit_burst = 20              # ZEPPELIN_RATE_LIMIT_BURST; must be >= 1 when rate_limit_rps > 0

[storage]
# backend = "s3"                     # STORAGE_BACKEND — "s3" or "local" (gcs/azure planned)
# bucket = "zeppelin"                # S3_BUCKET
# fail_fast = true                   # ZEPPELIN_STORAGE_FAIL_FAST; false allows intentionally degraded boot

# S3 / MinIO / R2
# s3_region = "us-east-1"            # AWS_REGION
# s3_endpoint = ""                   # S3_ENDPOINT — set for MinIO/R2
# s3_access_key_id = ""              # AWS_ACCESS_KEY_ID
# s3_secret_access_key = ""          # AWS_SECRET_ACCESS_KEY
# s3_allow_http = false              # S3_ALLOW_HTTP — "true" for local MinIO

[cache]
# dir = "/var/cache/zeppelin"        # ZEPPELIN_CACHE_DIR
# max_size_gb = 50                   # ZEPPELIN_CACHE_MAX_SIZE_GB
# hydration_enabled = false
# hydration_policy = "session_window"       # ZEPPELIN_HYDRATION_POLICY
# hydration_heat_queries = 3                # ZEPPELIN_HYDRATION_HEAT_QUERIES; must be > 0
# hydration_heat_window_secs = 60           # ZEPPELIN_HYDRATION_HEAT_WINDOW_SECS; must be > 0
# hydration_parallelism = 4                 # must be > 0
# hydration_max_segment_fraction = 0.5      # must be finite and in (0, 1]
# If a namespace's active warm set exceeds max_size_gb * hydration_max_segment_fraction,
# Zeppelin leaves it on the cold path and sets zeppelin_hydration_refused plus
# zeppelin_hydration_required_bytes. Raise hydration_max_segment_fraction, raise
# max_size_gb by provisioning a larger cache disk/node, or accept cold-path serving.
# Per-namespace hydration policy overrides are intentionally deferred until
# production traffic validates that extra selection matrix.

[indexing]
# default_num_centroids = 256        # ZEPPELIN_DEFAULT_NUM_CENTROIDS
# default_nprobe = 16                # ZEPPELIN_DEFAULT_NPROBE; must be > 0 and <= max_nprobe
# max_nprobe = 256                   # must be > 0
# kmeans_max_iterations = 25
# kmeans_convergence_epsilon = 0.0001
# oversample_factor = 3
# Namespace full_text_search field configs are validated on namespace create:
# k1 must be finite and in (0, 10], b must be finite and in [0, 1],
# max_token_length must be >= 1.

[query]
# rerank_coalesce_gap_bytes = 1048576      # ZEPPELIN_RERANK_COALESCE_GAP_BYTES
# cost_latency_profile = "balanced"        # "low_cost", "balanced", or "low_latency"

[gc]
# horizon_secs = 900                       # ZEPPELIN_GC_HORIZON_SECS
#                                          # Time-since-unreachable grace period before GC deletes objects.
#                                          # Must be >= cache.manifest_cache_ttl_ms rounded up to seconds
#                                          # + server.request_timeout_secs
#                                          # + gc.compaction_upload_window_secs
#                                          # + gc.skew_slop_secs.
#                                          # Do not derive this from compaction.interval_secs:
#                                          # the polling interval is causally unrelated to the
#                                          # reader-staleness window that can still reference old objects.
# compaction_upload_window_secs = 300      # ZEPPELIN_GC_COMPACTION_UPLOAD_WINDOW_SECS
# skew_slop_secs = 5                       # ZEPPELIN_GC_SKEW_SLOP_SECS
# allow_unsafe_short_horizon = false       # ZEPPELIN_GC_ALLOW_UNSAFE_SHORT_HORIZON
#                                          # true accepts a sub-floor horizon and emits a loud WARN at boot.

[compaction]
# interval_secs = 30                 # ZEPPELIN_COMPACTION_INTERVAL_SECS
# max_wal_fragments_before_compact = 100   # ZEPPELIN_MAX_WAL_FRAGMENTS — count trigger; must be >= 1
# max_wal_age_before_compact_secs = 300    # ZEPPELIN_MAX_WAL_AGE_SECS — age trigger; must be > 0:
#                                          # compact when the oldest uncompacted WAL
#                                          # fragment exceeds this age (bounded
#                                          # convergence for quiet namespaces)
# max_wal_bytes_before_compact = 67108864  # ZEPPELIN_MAX_WAL_BYTES — size trigger; must be > 0:
#                                          # compact when total uncompacted WAL bytes
#                                          # exceed this threshold (64 MB)
# retrain_imbalance_threshold = 5.0
# lease_duration_secs = 300          # per-namespace compaction lease (multi-node); must be > 0

[logging]
# level = "info"                     # RUST_LOG compatible
# format = "json"                    # ZEPPELIN_LOG_FORMAT — "json" or "pretty"
