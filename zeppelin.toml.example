# Zeppelin configuration
# Copy to zeppelin.toml and uncomment values to override defaults.
# Environment variables (shown in comments) take precedence over file values.
# Set ZEPPELIN_CONFIG to point to a custom config file path.
#
# For a validated config tuned to specific hardware, use the sizing advisor
# (`zeppelin_advisor emit-config`, see the README). The knob-by-knob tuning
# rationale, including hardcoded constants and env-only knobs not listed
# here, is documented in tasks/config_tuning.md.

[security]
# REQUIRED: choose exactly one explicit process posture. `enforced` refuses to
# boot until at least one unexpired, usable API key is configured below.
mode = "enforced"                    # "enforced" or "open_unsafe"
# readyz_public = false              # false keeps /readyz capability-gated
# policy_refresh_secs = 5            # must be > 0; phase 3 uses this freshness bound
# audit_s3 = true                    # required true in enforced mode; durable JSONL under _audit/
# audit_flush_secs = 2               # must be > 0; max background batch-flush interval
# license_path = ""                  # signed-license path; branching also requires the "branching" feature
# cursor_hmac_key_hex = "..."        # REQUIRED in enforced mode; generate: openssl rand -hex 32

# Generate one 43-character base64url secret and its SHA-256 digest:
# openssl rand -base64 32 | tr '+/' '-_' | tr -d '=\n' | tee /dev/stderr | shasum -a 256
# Store only the digest here; send the printed secret as part of the bearer.
# [[security.api_keys]]
# key_id = "zpk1_admin"
# name = "bootstrap-admin"
# sha256_hex = "replace-with-the-64-hex-character-digest"
# actions = ["*"]
# namespaces = ["*"]

[server]
# host = "0.0.0.0"                   # ZEPPELIN_HOST
# port = 8080                        # ZEPPELIN_PORT; must be > 0
# request_timeout_secs = 30          # ZEPPELIN_REQUEST_TIMEOUT_SECS; must be > 0
# max_concurrent_queries = 64        # ZEPPELIN_MAX_CONCURRENT_QUERIES
# max_batch_size = 50000             # ZEPPELIN_MAX_BATCH_SIZE; max vectors per accepted upsert/WAL fragment
# max_top_k = 10000                  # ZEPPELIN_MAX_TOP_K; must be > 0
# default_top_k = 10                 # ZEPPELIN_DEFAULT_TOP_K; must be in 1..=max_top_k
# shutdown_timeout_secs = 30         # ZEPPELIN_SHUTDOWN_TIMEOUT_SECS; must be > 0
# max_dimensions = 65536             # ZEPPELIN_MAX_DIMENSIONS
# max_vector_id_length = 1024        # ZEPPELIN_MAX_VECTOR_ID_LENGTH
# max_request_body_mb = 512          # ZEPPELIN_MAX_REQUEST_BODY_MB; oversized bodies fail before handler side effects
# max_retrieval_text_bytes = 1048576 # ZEPPELIN_MAX_RETRIEVAL_TEXT_BYTES; per inline text input
# max_retrieval_image_bytes = 20971520 # ZEPPELIN_MAX_RETRIEVAL_IMAGE_BYTES; decoded bytes per image
# max_retrieval_image_width = 32768   # ZEPPELIN_MAX_RETRIEVAL_IMAGE_WIDTH; declared pixels
# max_retrieval_image_height = 32768  # ZEPPELIN_MAX_RETRIEVAL_IMAGE_HEIGHT; declared pixels
# max_retrieval_units_per_request = 1000 # ZEPPELIN_MAX_RETRIEVAL_UNITS_PER_REQUEST; upserts + deletes
# retrieval_image_media_types = ["image/jpeg", "image/png", "image/webp"] # ZEPPELIN_RETRIEVAL_IMAGE_MEDIA_TYPES
# rate_limit_rps = 100               # ZEPPELIN_RATE_LIMIT_RPS; read/query rps per client, 0 disables reads
# rate_limit_burst = 200             # ZEPPELIN_RATE_LIMIT_BURST; read/query burst, must be >= 1 when read limiting is enabled
# write_rate_limit_rps = 50          # ZEPPELIN_WRITE_RATE_LIMIT_RPS; write/admin rps per client, 0 disables writes
# write_rate_limit_burst = 100       # ZEPPELIN_WRITE_RATE_LIMIT_BURST; write/admin burst, must be >= 1 when write limiting is enabled
# rate_limit_idle_ttl_secs = 600     # ZEPPELIN_RATE_LIMIT_IDLE_TTL_SECS; idle token buckets are evicted after this
# trusted_proxies = []               # ZEPPELIN_TRUSTED_PROXIES comma list; e.g. ["10.0.0.0/8", "127.0.0.1/32"]
# If Zeppelin runs behind a load balancer or reverse proxy, set trusted_proxies
# to only those proxy CIDRs. X-Forwarded-For is ignored from untrusted peers.

[branching]
# Branch routes require this switch AND a verified signed-license entitlement.
# See docs/branching-operations.md before enabling; Zeppelin supports forks,
# not merge/rebase/diff operations.
# enabled = false
# max_children_per_namespace = 256   # direct children; valid range 1..=4096
# max_depth = 16                     # ancestry depth; valid range 1..=64

[storage]
# backend = "s3"                     # STORAGE_BACKEND — "s3" or "local" (gcs/azure planned)
# bucket = "zeppelin"                # S3_BUCKET
# fail_fast = true                   # ZEPPELIN_STORAGE_FAIL_FAST; false allows intentionally degraded boot

# S3 / MinIO / R2
# s3_region = "us-east-1"            # AWS_REGION
# s3_endpoint = ""                   # S3_ENDPOINT — set for MinIO/R2
# s3_access_key_id = ""              # AWS_ACCESS_KEY_ID
# s3_secret_access_key = ""          # AWS_SECRET_ACCESS_KEY
# s3_allow_http = false              # S3_ALLOW_HTTP — "true" for local MinIO

[cache]
# dir = "/var/cache/zeppelin"        # ZEPPELIN_CACHE_DIR
# max_size_gb = 50                   # ZEPPELIN_CACHE_MAX_SIZE_GB
# memory_cache_max_mb = 256          # ZEPPELIN_MEMORY_CACHE_MAX_MB; in-memory cluster cache
# wal_fragment_cache_max_mb = 128    # ZEPPELIN_WAL_FRAGMENT_CACHE_MAX_MB; 0 disables decoded memo
# decoded_artifact_cache_max_mb = 64 # ZEPPELIN_DECODED_ARTIFACT_CACHE_MAX_MB; 0 disables FTS decode memo
# namespace_registry_ttl_ms = 5000   # positive cache TTL for namespace metadata
# hydration_enabled = false
# hydration_policy = "session_window"       # ZEPPELIN_HYDRATION_POLICY
# hydration_heat_queries = 3                # ZEPPELIN_HYDRATION_HEAT_QUERIES; must be > 0
# hydration_heat_window_secs = 60           # ZEPPELIN_HYDRATION_HEAT_WINDOW_SECS; must be > 0
# hydration_parallelism = 4                 # must be > 0
# hydration_max_segment_fraction = 0.5      # must be finite and in (0, 1]
# If a namespace's active warm set exceeds max_size_gb * hydration_max_segment_fraction,
# Zeppelin leaves it on the cold path and sets zeppelin_hydration_refused plus
# zeppelin_hydration_required_bytes. Raise hydration_max_segment_fraction, raise
# max_size_gb by provisioning a larger cache disk/node, or accept cold-path serving.
# Per-namespace hydration policy overrides are intentionally deferred until
# production traffic validates that extra selection matrix.

[indexing]
# default_num_centroids = 256        # ZEPPELIN_DEFAULT_NUM_CENTROIDS
# default_nprobe = 32                # ZEPPELIN_DEFAULT_NPROBE; must be > 0 and <= max_nprobe
#                                    # Flat segments resolve an omitted nprobe scale-aware:
#                                    # 3/16 of the active segment's clusters, floored here
# max_nprobe = 256                   # must be > 0
# kmeans_max_iterations = 25
# kmeans_convergence_epsilon = 0.0001
# oversample_factor = 3
# Namespace full_text_search field configs are validated on namespace create:
# k1 must be finite and in (0, 10], b must be finite and in [0, 1],
# max_token_length must be >= 1.
# bm25_max_full_scan_clusters = 500      # ZEPPELIN_BM25_MAX_FULL_SCAN_CLUSTERS; 0 disables cluster-count gate
# bm25_max_full_scan_vectors = 100000    # ZEPPELIN_BM25_MAX_FULL_SCAN_VECTORS; 0 disables vector-count gate

[query]
# rerank_coalesce_gap_bytes = 1048576      # ZEPPELIN_RERANK_COALESCE_GAP_BYTES
# cost_latency_profile = "balanced"        # "low_cost", "balanced", or "low_latency"

[gc]
# horizon_secs = 900                       # ZEPPELIN_GC_HORIZON_SECS
#                                          # Time-since-unreachable grace period before GC deletes objects.
#                                          # Must be >= cache.manifest_cache_ttl_ms rounded up to seconds
#                                          # + server.request_timeout_secs
#                                          # + gc.compaction_upload_window_secs
#                                          # + gc.skew_slop_secs.
#                                          # Do not derive this from compaction.interval_secs:
#                                          # the polling interval is causally unrelated to the
#                                          # reader-staleness window that can still reference old objects.
# compaction_upload_window_secs = 300      # ZEPPELIN_GC_COMPACTION_UPLOAD_WINDOW_SECS
# skew_slop_secs = 5                       # ZEPPELIN_GC_SKEW_SLOP_SECS
# allow_unsafe_short_horizon = false       # ZEPPELIN_GC_ALLOW_UNSAFE_SHORT_HORIZON
#                                          # true accepts a sub-floor horizon and emits a loud WARN at boot.
# manifest_history_keep_count = 128        # ZEPPELIN_GC_MANIFEST_HISTORY_KEEP_COUNT
#                                          # GC retains this many committed manifest snapshots as live roots.
# pitr_retention_secs = 0                  # ZEPPELIN_GC_PITR_RETENTION_SECS
#                                          # 0 disables time-based PITR retention; otherwise
#                                          # history younger than this window is also retained.

[compaction]
# interval_secs = 30                 # ZEPPELIN_COMPACTION_INTERVAL_SECS
# max_wal_fragments_before_compact = 100   # ZEPPELIN_MAX_WAL_FRAGMENTS — count trigger; must be >= 1
# max_wal_age_before_compact_secs = 300    # ZEPPELIN_MAX_WAL_AGE_SECS — age trigger; must be > 0:
#                                          # compact when the oldest uncompacted WAL
#                                          # fragment exceeds this age (bounded
#                                          # convergence for quiet namespaces)
# max_wal_bytes_before_compact = 67108864  # ZEPPELIN_MAX_WAL_BYTES — size trigger; must be > 0:
#                                          # compact when total uncompacted WAL bytes
#                                          # exceed this threshold (64 MB)
# retrain_imbalance_threshold = 5.0
# lease_duration_secs = 300          # per-namespace compaction lease (multi-node); must be > 0

[mmli]
# Exact truth-matrix storage for NEW text namespace epochs. Default: "f16".
# This choice is one-way: an existing f16 epoch cannot be switched in place.
# INT8-G32 also requires the qualified text-lane stamp; startup fails closed
# rather than falling back when the epoch/configuration is inconsistent.
# text_matrix_dtype = "f16"          # "f16" or "int8_g32"
# visual_matrix_dtype = "f16"        # keep f16; visual INT8-G32 is unqualified
#
# Measured late-query profiles (Apple M3 Max, loopback MinIO, 1,109 queries):
#
#   General/default profile — f16, exact historical quality:
#     candidate_k = 1000, read_gap_budget_bytes = 65536
#     recall@10 0.980072; p50 72 ms after parallel resident scanning.
#
#   Lowest-latency text profile — accepts 0.54 percentage-point recall loss:
#     text_matrix_dtype = "int8_g32"
#     candidate_k = 1000, read_gap_budget_bytes = 524288
#     recall@10 0.974662; p50 48 ms.
#
#   Quality-preserving text profile — recommended when recall must not regress:
#     text_matrix_dtype = "int8_g32"
#     candidate_k = 1200, read_gap_budget_bytes = 786432
#     recall@10 0.980703 (above f16 K=1000); p50 53 ms.
#
# Both INT8 profiles keep read_max_concurrency = 16. Large gap budgets are for
# this qualified high-density latency shape only: the sparse 50k-unit replay
# showed severe byte amplification without a corresponding GET reduction.
# See tasks/LateLatency/results/phase09-scan-int8.md for full p50/p95/p99,
# requests, bytes, and recall evidence.
# allow_dev_encoder = false          # ZEPPELIN_MMLI_ALLOW_DEV_ENCODER; local/test opt-in only
# enrichment_queue_capacity = 64     # ZEPPELIN_MMLI_ENRICHMENT_QUEUE_CAPACITY; must be > 0
# max_fragments_per_tick = 8         # ZEPPELIN_MMLI_MAX_FRAGMENTS_PER_TICK; must be > 0
# max_bytes_per_tick = 67108864      # ZEPPELIN_MMLI_MAX_BYTES_PER_TICK; must be > 0
# max_retry_attempts = 3             # ZEPPELIN_MMLI_MAX_RETRY_ATTEMPTS; must be > 0
# shutdown_timeout_secs = 30         # ZEPPELIN_MMLI_SHUTDOWN_TIMEOUT_SECS; must be > 0

# Late-interaction segment index and read-plan knobs. The read defaults are
# measured operating points (see tasks/LateLatency/results/); read_gap_budget
# and read_max_request were probed across corpora and are not free wins to
# raise. For a low-latency text namespace, take candidate_k and
# read_gap_budget_bytes from exactly one measured profile above.
# [mmli.segment]
# nlist = 256                        # candidate IVF centroid count
# probe_budget = 16                  # candidate IVF clusters read per query
# candidate_k = 1000                 # use 1200 for quality-preserving INT8-G32
# kmeans_max_iterations = 100
# kmeans_convergence_epsilon = 0.0001
# max_matrix_object_bytes = 67108864         # 64 MiB record-major matrix blocks
# max_cluster_object_bytes = 8388608         # 8 MiB wave-one cluster shards
# max_resident_bootstrap_bytes = 134217728   # 128 MiB resident centroid cap
# read_gap_budget_bytes = 65536              # speed INT8: 524288; quality INT8: 786432
# read_max_request_bytes = 8388608           # 8 MiB per physical ranged request
# read_max_concurrency = 16                  # concurrent truth-wave range reads
# incremental_max_changed_fraction = 0.2

# Optional. Required only when an active profile selects a pinned worker.
# The profile epoch, not this mutable config, owns the S3 model-bundle prefix.
# [mmli.worker]
# venv_dir = "/opt/zeppelin/mmli/venv"                 # ZEPPELIN_MMLI_WORKER_VENV_DIR
# python_binary = "/opt/zeppelin/mmli/venv/bin/python" # ZEPPELIN_MMLI_WORKER_PYTHON_BINARY
# worker_script = "/opt/zeppelin/mmli/worker.py"       # ZEPPELIN_MMLI_WORKER_SCRIPT
# scratch_dir = "/var/cache/zeppelin/mmli/scratch"     # ZEPPELIN_MMLI_WORKER_SCRATCH_DIR
# bundle_cache_dir = "/var/cache/zeppelin/mmli/bundles" # ZEPPELIN_MMLI_WORKER_BUNDLE_CACHE_DIR
# max_batch_units = 8                 # ZEPPELIN_MMLI_WORKER_MAX_BATCH_UNITS
# max_batch_input_bytes = 33554432    # ZEPPELIN_MMLI_WORKER_MAX_BATCH_INPUT_BYTES
# max_batch_pixels = 67108864         # ZEPPELIN_MMLI_WORKER_MAX_BATCH_PIXELS
# max_batch_rows = 16384              # ZEPPELIN_MMLI_WORKER_MAX_BATCH_ROWS
# max_tensor_bytes = 67108864         # ZEPPELIN_MMLI_WORKER_MAX_TENSOR_BYTES
# max_protocol_line_bytes = 1048576   # ZEPPELIN_MMLI_WORKER_MAX_PROTOCOL_LINE_BYTES
# max_stderr_bytes = 65536            # ZEPPELIN_MMLI_WORKER_MAX_STDERR_BYTES
# handshake_timeout_secs = 120        # ZEPPELIN_MMLI_WORKER_HANDSHAKE_TIMEOUT_SECS
# request_timeout_secs = 120          # ZEPPELIN_MMLI_WORKER_REQUEST_TIMEOUT_SECS

[logging]
# level = "info"                     # RUST_LOG compatible
# format = "json"                    # ZEPPELIN_LOG_FORMAT — "json" or "pretty"
