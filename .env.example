# Zeppelin Configuration
# Copy this to .env and fill in your values

# Config file path (default: ./zeppelin.toml if it exists)
# ZEPPELIN_CONFIG=./zeppelin.toml

# Storage backend (s3 | local) — gcs/azure planned
STORAGE_BACKEND=s3

# AWS S3 / MinIO / R2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=zeppelin
S3_ENDPOINT=
S3_ALLOW_HTTP=false

# GCS
GCS_SERVICE_ACCOUNT_PATH=

# Azure
AZURE_ACCOUNT=
AZURE_ACCESS_KEY=

# Test configuration
TEST_BACKEND=s3
TEST_S3_BUCKET=zeppelin-test

# Server
ZEPPELIN_HOST=0.0.0.0
ZEPPELIN_PORT=8080
# ZEPPELIN_REQUEST_TIMEOUT_SECS=30
# ZEPPELIN_MAX_CONCURRENT_QUERIES=64
# ZEPPELIN_MAX_BATCH_SIZE=50000
# ZEPPELIN_MAX_TOP_K=10000
# ZEPPELIN_SHUTDOWN_TIMEOUT_SECS=30
# ZEPPELIN_MAX_DIMENSIONS=65536
# ZEPPELIN_MAX_VECTOR_ID_LENGTH=1024
# ZEPPELIN_MAX_REQUEST_BODY_MB=512

# Cache
# ZEPPELIN_CACHE_DIR=/var/cache/zeppelin
# ZEPPELIN_CACHE_MAX_SIZE_GB=50

# Indexing
# ZEPPELIN_DEFAULT_NUM_CENTROIDS=256
# ZEPPELIN_DEFAULT_NPROBE=16

# Compaction
# ZEPPELIN_COMPACTION_INTERVAL_SECS=30

# Multimodal late-interaction pinned worker (optional)
# ZEPPELIN_MMLI_WORKER_VENV_DIR=/opt/zeppelin/mmli/venv
# ZEPPELIN_MMLI_WORKER_PYTHON_BINARY=/opt/zeppelin/mmli/venv/bin/python
# ZEPPELIN_MMLI_WORKER_SCRIPT=/opt/zeppelin/mmli/worker.py
# ZEPPELIN_MMLI_WORKER_SCRATCH_DIR=/var/cache/zeppelin/mmli/scratch
# ZEPPELIN_MMLI_WORKER_BUNDLE_CACHE_DIR=/var/cache/zeppelin/mmli/bundles
# ZEPPELIN_MMLI_WORKER_MAX_BATCH_UNITS=8
# ZEPPELIN_MMLI_WORKER_MAX_BATCH_INPUT_BYTES=33554432
# ZEPPELIN_MMLI_WORKER_MAX_BATCH_PIXELS=67108864
# ZEPPELIN_MMLI_WORKER_MAX_BATCH_ROWS=16384
# ZEPPELIN_MMLI_WORKER_MAX_TENSOR_BYTES=67108864
# ZEPPELIN_MMLI_WORKER_MAX_PROTOCOL_LINE_BYTES=1048576
# ZEPPELIN_MMLI_WORKER_MAX_STDERR_BYTES=65536
# ZEPPELIN_MMLI_WORKER_HANDSHAKE_TIMEOUT_SECS=120
# ZEPPELIN_MMLI_WORKER_REQUEST_TIMEOUT_SECS=120

# Logging
RUST_LOG=info
# ZEPPELIN_LOG_FORMAT=json
